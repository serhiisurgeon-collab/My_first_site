rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'; }
    function googleUser() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function frozen() { return get(/databases/$(database)/documents/control/state).data.frozen; }
    function validSettings(s) {
      return s.enabled is bool && s.moderationMode in ['pre','post'] &&
        ((s.schemaVersion == 1 && s.keys().hasAll(['enabled','moderationMode','schemaVersion']) &&
          s.keys().hasOnly(['enabled','moderationMode','schemaVersion'])) ||
         (s.schemaVersion == 2 && s.keys().hasAll(['enabled','visibility','moderationMode','schemaVersion']) &&
          s.keys().hasOnly(['enabled','visibility','moderationMode','schemaVersion']) &&
          s.visibility in ['visible','hidden'] && !(s.visibility == 'hidden' && s.enabled)));
    }
    function enabled() {
      let s = get(/databases/$(database)/documents/settings/comments).data;
      return validSettings(s) && s.enabled && s.get('visibility', 'visible') == 'visible' && !frozen();
    }
    function blocked() { return exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid)); }
    function bounded(n) { return request.query.limit != null && request.query.limit <= n; }
    function exportOwner() { return admin() && frozen() && get(/databases/$(database)/documents/control/state).data.ownerUid == request.auth.uid; }
    function visible(c) { return c.status in ['published', 'deleted']; }
    function owner(id) { return signedIn() && exists(/databases/$(database)/documents/commentOwners/$(id)) && get(/databases/$(database)/documents/commentOwners/$(id)).data.authorUid == request.auth.uid; }
    function privatePair(id,c) {
      let o = getAfter(/databases/$(database)/documents/commentOwners/$(id)).data;
      return o.authorUid == request.auth.uid && o.articleId == c.articleId && o.createdAt == request.time;
    }
    function publicComment(c) {
      return c.keys().hasAll(['schemaVersion','articleId','authorName','text','parentId','depth','status','createdAt','updatedAt']) &&
        c.keys().hasOnly(['schemaVersion','articleId','authorName','text','parentId','depth','status','createdAt','updatedAt']) && c.schemaVersion == 3;
    }
    function commentFields(c) {
      return c.keys().hasAll(['schemaVersion','articleId','authorName','text','parentId','depth','status','createdAt','updatedAt']) &&
        c.keys().hasOnly(['schemaVersion','articleId','authorName','text','parentId','depth','status','createdAt','updatedAt']) &&
        c.articleId is string && exists(/databases/$(database)/documents/articles/$(c.articleId)) &&
        c.schemaVersion == 3 &&
        c.authorName is string && c.authorName.size() <= 120 &&
        c.text is string && c.text.size() <= 3000 &&
        (c.parentId == null || (c.parentId is string && c.parentId.size() > 0 && c.parentId.size() <= 128)) &&
        c.depth is int && c.depth >= 0 && c.depth <= 3 &&
        c.status in ['pending','published','hidden','deleted'] &&
        c.createdAt is timestamp && c.updatedAt is timestamp;
    }
    function validParent(c) {
      return (c.parentId == null && c.depth == 0) ||
        (c.parentId != null && exists(/databases/$(database)/documents/comments/$(c.parentId)) &&
        get(/databases/$(database)/documents/comments/$(c.parentId)).data.articleId == c.articleId &&
        get(/databases/$(database)/documents/comments/$(c.parentId)).data.status == 'published' &&
        c.depth == get(/databases/$(database)/documents/comments/$(c.parentId)).data.depth + 1);
    }
    function allowedRate() {
      return !exists(/databases/$(database)/documents/rateLimits/$(request.auth.uid)) ||
        request.time >= get(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastSubmittedAt + duration.value(60, 's');
    }
    match /comments/{id} {
      allow get: if (publicComment(resource.data) && (visible(resource.data) || owner(id))) || admin();
      allow list: if ((admin() && bounded(100)) || exportOwner()) ||
        (bounded(20) && resource.data.schemaVersion == 3 && resource.data.keys().hasOnly(['schemaVersion','articleId','authorName','text','parentId','depth','status','createdAt','updatedAt']) && visible(resource.data));
      allow create: if googleUser() && enabled() && !blocked() && commentFields(request.resource.data) &&
        id.matches('^[A-Za-z0-9]{20}$') && !id.matches('.*' + request.auth.uid + '.*') && privatePair(id,request.resource.data) &&
        request.resource.data.authorName == ('name' in request.auth.token ? request.auth.token.name : 'Google user') &&
        request.resource.data.text.size() > 0 && request.resource.data.authorName.size() > 0 &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time &&
        request.resource.data.status == (get(/databases/$(database)/documents/settings/comments).data.moderationMode == 'pre' ? 'pending' : 'published') &&
        validParent(request.resource.data) && allowedRate() &&
        getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.commentId == id &&
        getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastSubmittedAt == request.time;
      allow update: if admin() && !frozen() && commentFields(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schemaVersion','articleId','parentId','depth','createdAt']) &&
        request.resource.data.updatedAt == request.time &&
        getAfter(/databases/$(database)/documents/moderation/$(id)).data.at == request.time &&
        getAfter(/databases/$(database)/documents/moderation/$(id)).data.moderatorUid == request.auth.uid &&
        ((((request.resource.data.status == 'published' && getAfter(/databases/$(database)/documents/moderation/$(id)).data.action == 'approve') || (request.resource.data.status == 'hidden' && getAfter(/databases/$(database)/documents/moderation/$(id)).data.action == 'hide')) && request.resource.data.text == resource.data.text && request.resource.data.authorName == resource.data.authorName && request.resource.data.text.size() > 0 && request.resource.data.authorName.size() > 0 && resource.data.status != 'deleted') ||
        (getAfter(/databases/$(database)/documents/moderation/$(id)).data.action == 'delete' && request.resource.data.text == '' && request.resource.data.authorName == '' &&
        request.resource.data.status == (resource.data.status in ['published','deleted'] ? 'deleted' : 'hidden')));
      allow delete: if false;
    }
    match /commentOwners/{id} {
      allow get: if admin() || (signedIn() && resource.data.authorUid == request.auth.uid);
      allow list: if (admin() && (bounded(100) || exportOwner())) || (signedIn() && bounded(20) && resource.data.authorUid == request.auth.uid);
      allow create: if googleUser() && enabled() && !blocked() &&
        id.matches('^[A-Za-z0-9]{20}$') && !id.matches('.*' + request.auth.uid + '.*') &&
        request.resource.data.keys().hasAll(['authorUid','articleId','createdAt','confirmation']) &&
        request.resource.data.keys().hasOnly(['authorUid','articleId','createdAt','confirmation']) &&
        request.resource.data.authorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
        request.resource.data.confirmation.keys().hasAll(['accepted','version','confirmedAt']) &&
        request.resource.data.confirmation.keys().hasOnly(['accepted','version','confirmedAt']) &&
        request.resource.data.confirmation.accepted == true &&
        request.resource.data.confirmation.version == (get(/databases/$(database)/documents/settings/comments).data.moderationMode == 'pre' ? 'comments-publication-2026-10-v1' : 'comments-publication-post-2026-10-v1') &&
        request.resource.data.confirmation.confirmedAt == request.time &&
        !exists(/databases/$(database)/documents/comments/$(id)) &&
        getAfter(/databases/$(database)/documents/comments/$(id)).data.schemaVersion == 3 &&
        getAfter(/databases/$(database)/documents/comments/$(id)).data.articleId == request.resource.data.articleId &&
        getAfter(/databases/$(database)/documents/comments/$(id)).data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.commentId == id &&
        getAfter(/databases/$(database)/documents/rateLimits/$(request.auth.uid)).data.lastSubmittedAt == request.time;
      allow update, delete: if false;
    }
    match /rateLimits/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin() && (bounded(100) || exportOwner());
      allow create, update: if googleUser() && request.auth.uid == uid && enabled() && !blocked() && allowedRate() &&
        request.resource.data.keys().hasAll(['lastSubmittedAt','commentId']) && request.resource.data.keys().hasOnly(['lastSubmittedAt','commentId']) &&
        request.resource.data.lastSubmittedAt == request.time && request.resource.data.commentId is string && request.resource.data.commentId.size() <= 128 &&
        !exists(/databases/$(database)/documents/comments/$(request.resource.data.commentId)) &&
        getAfter(/databases/$(database)/documents/commentOwners/$(request.resource.data.commentId)).data.authorUid == uid &&
        getAfter(/databases/$(database)/documents/comments/$(request.resource.data.commentId)).data.createdAt == request.time;
      allow delete: if false;
    }
    match /moderation/{id} {
      allow get: if admin();
      allow list: if admin() && (bounded(100) || exportOwner());
      allow create, update: if admin() && !frozen() && request.resource.data.keys().hasAll(['moderatorUid','action','at']) &&
        request.resource.data.keys().hasOnly(['moderatorUid','action','at']) && request.resource.data.moderatorUid == request.auth.uid &&
        request.resource.data.action in ['approve','hide','delete'] && request.resource.data.at == request.time &&
        getAfter(/databases/$(database)/documents/comments/$(id)).data.updatedAt == request.time;
      allow delete: if false;
    }
    match /blockedUsers/{uid} {
      allow get: if admin() || (signedIn() && request.auth.uid == uid);
      allow list: if admin() && (bounded(100) || exportOwner());
      allow create, update: if admin() && !frozen() && request.resource.data.keys().hasAll(['blockedAt','blockedBy']) &&
        request.resource.data.keys().hasOnly(['blockedAt','blockedBy']) && request.resource.data.blockedAt == request.time && request.resource.data.blockedBy == request.auth.uid;
      allow delete: if admin() && !frozen();
    }
    match /admins/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || admin());
      allow list: if admin() && (bounded(100) || exportOwner());
      allow write: if false;
    }
    match /articles/{id} {
      allow get: if resource.data.keys().hasAll(['slug','aliases']) && resource.data.keys().hasOnly(['slug','aliases']);
      allow list: if exportOwner() || (bounded(100) && resource.data.keys().hasOnly(['slug','aliases']));
      allow write: if false;
    }
    match /settings/comments {
      allow get: if validSettings(resource.data);
      allow list: if exportOwner();
      allow update: if admin() && !frozen() && validSettings(request.resource.data) &&
        (request.resource.data.schemaVersion == 2 || resource.data.schemaVersion == 1);
      allow create, delete: if false;
    }
    match /control/state {
      allow get: if admin();
      allow list: if exportOwner();
      allow update: if admin() && request.resource.data.keys().hasAll(['frozen','ownerUid']) &&
        request.resource.data.keys().hasOnly(['frozen','ownerUid']) &&
        ((!resource.data.frozen && request.resource.data.frozen == true && request.resource.data.ownerUid == request.auth.uid) ||
         (resource.data.frozen && resource.data.ownerUid == request.auth.uid && request.resource.data.frozen == false && request.resource.data.ownerUid == null));
      allow create, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
